{
  "name": "dtr-web",
  "version": "2.0.0",
  "private": true,
  "packageManager": "pnpm@12.5.1",
  "homepage": "https://github.com/NUDelta/dtr-web",
  "engines": {
    "node": ">=22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "pnpm lint:ci && next build",
    "typecheck": "tsc --noEmit",
    "start": "next start -H 0.0.0.0 -p ${PORT:-8080}",
    "lint": "eslint .",
    "lint:ci": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "postinstall": "husky || true"
  },
  "dependencies": {
    "@next/third-parties": "16.3.5",
    "@tanstack/react-form-nextjs": "^1.33.5",
    "@zl-asica/react": "^0.13.0",
    "cloudflare": "^7.1.0",
    "clsx": "^2.1.1",
    "d3-scale": "^4.0.2",
    "framer-motion": "^13.4.0",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "next-nprogress-bar": "^2.4.7",
    "papaparse": "^5.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "react-player": "^3.4.0",
    "react-simple-maps": "^5.0.5",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "rss": "^1.2.2",
    "sharp": "^0.35.4",
    "sonner": "^2.0.8",
    "ts-airtable": "^0.5.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@eslint-react/eslint-plugin": "^5.20.2",
    "@next/eslint-plugin-next": "^16.3.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/d3-scale": "^4.0.9",
    "@types/node": "^24.10.1",
    "@types/papaparse": "^5.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-simple-maps": "^3.0.6",
    "@types/rss": "^0.0.32",
    "baseline-browser-mapping": "^2.11.25",
    "eslint": "^10.11.0",
    "eslint-plugin-format": "^2.0.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "husky": "^9.1.7",
    "nano-staged": "^1.0.2",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "nano-staged": {
    "src/**/*.{js,jsx,ts,tsx,json,md,mdx}": [
      "eslint --fix"
    ]
  },
  "browserslist": {
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
